{
  "name": "agent-office",
  "version": "0.1.0",
  "description": "Văn phòng 3D hiển thị các agent Claude Code của project làm việc theo thời gian thực",
  "type": "module",
  "bin": {
    "agent-office": "bin/agent-office.mjs"
  },
  "files": [
    "bin",
    "server",
    "!server/*.test.mjs",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "start": "node bin/agent-office.mjs run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  }
}
